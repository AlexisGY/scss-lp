{
  "name": "scss-lp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "postcss": "^8.5.0",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "sass-lint": "1.13.1"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/generator.mjs --test-coverage-lines=60",
    "check": "npm run lint && npm run coverage",
    "build": "node scripts/build.mjs"
  },
  "overrides": {
    "minimist": "^1.2.8",
    "merge": "^2.1.1",
    "minimatch": "^3.1.5",
    "shelljs": "^0.8.5",
    "ajv": "^6.14.0"
  }
}
